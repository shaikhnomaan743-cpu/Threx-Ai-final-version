# Threx AI — Root .env.example
# Copy to .env for docker-compose. See also:
#  - backend/cybersentinel-backend/.env.example
#  - frontend/.env.example

# Backend (see backend/cybersentinel-backend/.env.example for all vars)
CYBERSENTINEL_ENV=development
CYBERSENTINEL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CYBERSENTINEL_POSTGRES_DSN=postgresql://threx:CHANGE_ME_STRONG_PASSWORD@postgres:5432/threxai
CYBERSENTINEL_DB_PATH=data/alerts.db
CYBERSENTINEL_REDIS_URL=redis://redis:6379/0
CYBERSENTINEL_LIVE_INTERFACE=

# Frontend
VITE_API_URL=http://localhost:8000

# Compose Postgres
POSTGRES_DB=threxai
POSTGRES_USER=threx
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
