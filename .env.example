# THREX AI — root compose environment
# Copy to .env and edit. Never commit the resulting .env.

# ── Postgres (used by docker-compose) ────────────────────────────────
POSTGRES_USER=threx
POSTGRES_DB=threxai
# REQUIRED: set a strong value before any non-local deployment.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Ports published on the host ──────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=80
REDIS_PORT=6379
POSTGRES_PORT=5432
