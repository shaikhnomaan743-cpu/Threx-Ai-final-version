# Threx AI Frontend — Environment
# Copy to .env and adjust

# Backend API URL (FastAPI). Must match CORS origins on backend.
VITE_API_URL=http://localhost:8000

# Data mode label (optional, overrides auto-detection)
# simulation | backend | live
# VITE_DATA_MODE=simulation

# Mapbox token for geo visualizations (optional)
# VITE_MAPBOX_TOKEN=
