# Threx AI Backend — Environment Configuration
# Copy to .env and adjust. All vars prefixed CYBERSENTINEL_ per app/config.py
# Never commit real secrets.

# --- Core ---
CYBERSENTINEL_ENV=development
# options: development | staging | production
CYBERSENTINEL_LOG_LEVEL=info
CYBERSENTINEL_PROJECT_NAME=Threx AI Backend
CYBERSENTINEL_VERSION=2.0.0

# --- Network ---
# CORS: comma-separated allowed origins
CYBERSENTINEL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# API listens on 0.0.0.0:8000 by default; workers 4 in docker
# PORT is read by uvicorn/docker-compose externally

# --- Database ---
# PostgreSQL (production): set a strong password, use pg_data volume
CYBERSENTINEL_POSTGRES_DSN=postgresql://threx:CHANGE_ME_STRONG_PASSWORD@postgres:5432/threxai
# SQLite fallback (development, also used when postgres unavailable)
CYBERSENTINEL_DB_PATH=data/alerts.db
CYBERSENTINEL_REDIS_URL=redis://redis:6379/0

# --- Ingest ---
# Leave empty for passive-seeded demo (uses BACKEND SEEDED DATA)
# Set to e.g. eth0 + run as privileged container to enable live sniffing (auto-detected otherwise)
CYBERSENTINEL_LIVE_INTERFACE=
CYBERSENTINEL_PCAP_DIR=data/pcaps
CYBERSENTINEL_FLOW_TTL_SECONDS=60

# --- Models ---
CYBERSENTINEL_MODELS_DIR=data/models
CYBERSENTINEL_ARTIFACTS_DIR=app/models/artifacts
CYBERSENTINEL_DDOS_SYN_RATIO=10.0
CYBERSENTINEL_DDOS_UDP_AMP_RATIO=20.0
CYBERSENTINEL_BEACON_MIN_OBSERVATIONS=8
CYBERSENTINEL_SCAN_UNIQUE_PORTS_THRESHOLD=20
CYBERSENTINEL_SCAN_UNIQUE_HOSTS_THRESHOLD=15
CYBERSENTINEL_EXFIL_BYTE_RATIO=10.0
CYBERSENTINEL_EXFIL_MIN_VOLUME_BYTES=10485760

# --- Security ---
# Optional API key: if set, clients must send X-API-Key: <key> header
CYBERSENTINEL_API_KEY=
CYBERSENTINEL_RATE_LIMIT_PER_MINUTE=120
