# THREX AI Backend — environment
# Copy to .env and edit. All vars are prefixed CYBERSENTINEL_ (see app/config.py).
# Never commit real secrets.

# ── Core ─────────────────────────────────────────────────────────────
CYBERSENTINEL_ENV=development           # development | staging | production
CYBERSENTINEL_LOG_LEVEL=info            # debug | info | warning | error
CYBERSENTINEL_PROJECT_NAME=Threx AI Backend
CYBERSENTINEL_VERSION=2.0.0

# ── Startup strictness ───────────────────────────────────────────────
# false (default): if the inference engine fails to load, startup ABORTS.
# A backend that cannot detect threats must not report itself healthy — this
# is what previously allowed a missing `pandas` to go unnoticed while the API
# served pre-seeded rows as though detection were running.
# Set true ONLY for frontend work on a machine without the ML wheels.
CYBERSENTINEL_ALLOW_DEGRADED_START=false

# ── Network / CORS ───────────────────────────────────────────────────
# Comma-separated allowed origins. Include both localhost and 127.0.0.1:
# browsers treat them as different origins.
CYBERSENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────
CYBERSENTINEL_POSTGRES_DSN=postgresql://threx:CHANGE_ME_STRONG_PASSWORD@postgres:5432/threxai
CYBERSENTINEL_DB_PATH=data/alerts.db    # SQLite fallback for local dev
CYBERSENTINEL_REDIS_URL=redis://redis:6379/0

# ── Sensor / ingest ──────────────────────────────────────────────────
# Set to a NIC (e.g. eth0) to enable passive live capture. Requires
# CAP_NET_RAW. Empty = replay the bundled lab flows instead.
CYBERSENTINEL_LIVE_INTERFACE=
CYBERSENTINEL_PCAP_DIR=data/pcaps
CYBERSENTINEL_FLOW_TTL_SECONDS=60

# ── Ingest queue / batch inference ───────────────────────────────────
# Capture enqueues and a worker drains in batches, so packet ingestion never
# blocks the event loop. Batching amortises the fixed per-call sklearn cost.
CYBERSENTINEL_INGEST_QUEUE_MAXSIZE=10000
CYBERSENTINEL_INGEST_BATCH_SIZE=64
CYBERSENTINEL_INGEST_BATCH_TIMEOUT_MS=50
# Replay pacing, flows/sec. 0 = unthrottled.
# WARNING: 0 saturates the event loop and the HTTP API stops responding. Use 0
# only for offline benchmarking, never while serving the dashboard.
CYBERSENTINEL_REPLAY_TARGET_FPS=200

# ── Models ───────────────────────────────────────────────────────────
CYBERSENTINEL_MODELS_DIR=data/models
CYBERSENTINEL_ARTIFACTS_DIR=app/models/artifacts

# ── Detection thresholds ─────────────────────────────────────────────
CYBERSENTINEL_DDOS_SYN_RATIO=10.0
CYBERSENTINEL_DDOS_UDP_AMP_RATIO=20.0
CYBERSENTINEL_BEACON_MIN_OBSERVATIONS=8
CYBERSENTINEL_SCAN_UNIQUE_PORTS_THRESHOLD=20
CYBERSENTINEL_SCAN_UNIQUE_HOSTS_THRESHOLD=15
CYBERSENTINEL_EXFIL_BYTE_RATIO=10.0
CYBERSENTINEL_EXFIL_MIN_VOLUME_BYTES=10485760

# ── Security ─────────────────────────────────────────────────────────
# If set, clients must send  X-API-Key: <key>
CYBERSENTINEL_API_KEY=
CYBERSENTINEL_RATE_LIMIT_PER_MINUTE=600
